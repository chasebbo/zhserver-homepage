  {
   "code": "\nshader_type spatial;\nuniform int kind = 0;\n// Jute sandbag: basket weave from the UV (fades with distance), mottled\n// fill, dirt toward the bottom of the bag, wet patches, white salt bloom,\n// the seam (COLOR.g) stitched and darker, a tear (COLOR.r) dark with sand.\nuniform vec4 tone : source_color = vec4(0.54, 0.48, 0.36, 1.0);\nuniform float wet = 0.0;\nglobal uniform float zh_wetness;\n// (kind 1, the painted HESCO, is gone: 8.81, every HESCO is the Master-Kit\n// model of tools/goldstandard_hesco.gd.)\nuniform vec3 scene_colour = vec3(1.0);\n// Vehicle paint: satin finish, road dirt rising from the sills, darker\n// panel edges are geometry (chamfers) ‚Äì no texture needed.\nuniform vec3 paint : source_color = vec3(0.3, 0.33, 0.24);\nuniform float dirt = 0.35;\nuniform float gloss = 0.45;\n// Burned-out vehicle body: charcoal paint with ash bloom, rust breaking\n// through on the upper panels, soot streaks; no gloss.\nuniform float rust = 0.55;\n// Bark of the debris branches.\nuniform vec3 dark : source_color = vec3(0.15, 0.12, 0.10);\nuniform vec3 light : source_color = vec3(0.37, 0.32, 0.26);\nvarying vec3 lp;\nvarying vec3 wp;\nvarying vec3 wpos;\nvarying vec3 wnrm;\nfloat hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }\nfloat noise(vec2 x) { vec2 i = floor(x); vec2 f = fract(x); f = f * f * (3.0 - 2.0 * f);\n\treturn mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y); }\nvoid vertex() {\n\tlp = VERTEX;\n\twp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;\n\twpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;\n\twnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);\n}\nvoid vehicle_paint(inout vec3 albedo, inout float roughness, inout float metallic, inout float specular) {\n\tfloat grime = (1.0 - smoothstep(0.35, 1.25, wpos.y)) * dirt;\n\tfloat speck = noise(wpos.xz * 7.0 + wpos.y * 5.0);\n\tvec3 col = paint * (0.92 + 0.12 * noise(wpos.xz * 0.8 + wpos.y));\n\tcol = mix(col, vec3(0.32, 0.27, 0.21), clamp(grime * (0.6 + 0.6 * speck), 0.0, 0.85));\n\t// Block 8 (vehicles read flat from the 75¬∞ camera): road dust settles on\n\t// roof and bonnet, streaks run down the sides, fine scratches catch light.\n\tfloat up = smoothstep(0.6, 0.95, wnrm.y);\n\tcol = mix(col, vec3(0.55, 0.52, 0.46), up * (0.12 + 0.18 * noise(wpos.xz * 3.1)) * (0.4 + dirt));\n\tfloat streak = smoothstep(0.55, 0.9, noise(vec2(wpos.x * 9.0 + wpos.z * 9.0, wpos.y * 0.6)));\n\tcol *= 1.0 - (1.0 - up) * streak * 0.12 * dirt;\n\tcol += vec3(0.05) * smoothstep(0.82, 0.98, noise(wpos.xz * 23.0 + wpos.y * 11.0)) * up;\n\talbedo = col * scene_colour;\n\troughness = mix(1.0 - gloss, 0.95, grime);\n\tmetallic = 0.2 * (1.0 - grime);\n\tspecular = 0.45;\n}\nvoid burnt(inout vec3 albedo, inout float roughness, inout float metallic) {\n\tfloat n = noise(wpos.xz * 2.3 + wpos.y * 1.7);\n\tfloat m = noise(wpos.xz * 7.0 - wpos.y * 4.0);\n\tvec3 soot = vec3(0.07, 0.065, 0.06);\n\tvec3 ash = vec3(0.36, 0.34, 0.31);\n\tvec3 rusty = mix(vec3(0.36, 0.17, 0.08), vec3(0.5, 0.28, 0.12), m);\n\tfloat r = smoothstep(0.45, 0.8, n) * rust * smoothstep(0.4, 1.3, wpos.y);\n\tvec3 col = mix(soot, ash, smoothstep(0.55, 0.95, m) * 0.6);\n\tcol = mix(col, rusty, r);\n\talbedo = col;\n\troughness = 0.96;\n\tmetallic = 0.08;\n}\nvoid bark(vec2 bark_uv, inout vec3 albedo, inout float roughness) {\n\tvec2 uv = bark_uv * vec2(16.0, 4.0);\n\tfloat fissure = noise(vec2(uv.x, uv.y * 0.5 + noise(uv * 0.7) * 2.5));\n\tfloat plates = smoothstep(0.32, 0.62, fissure);\n\tfloat grain = noise(bark_uv * vec2(70.0, 10.0));\n\talbedo = mix(dark, light, plates * 0.8 + grain * 0.2);\n\troughness = 0.96;\n}\nvoid fragment() {\n\tif (kind == 4) {\n\t\tvec3 albedo = vec3(0.0);\n\t\tfloat roughness = 1.0;\n\t\tbark(UV, albedo, roughness);\n\t\tALBEDO = albedo;\n\t\tROUGHNESS = roughness;\n\t} else if (kind == 3) {\n\t\tvec3 albedo = vec3(0.0);\n\t\tfloat roughness = 1.0;\n\t\tfloat metallic = 0.0;\n\t\tburnt(albedo, roughness, metallic);\n\t\tALBEDO = albedo;\n\t\tROUGHNESS = roughness;\n\t\tMETALLIC = metallic;\n\t} else if (kind == 2) {\n\t\tvec3 albedo = vec3(0.0);\n\t\tfloat roughness = 1.0;\n\t\tfloat metallic = 0.0;\n\t\tfloat specular = 0.5;\n\t\tvehicle_paint(albedo, roughness, metallic, specular);\n\t\tALBEDO = albedo;\n\t\tROUGHNESS = roughness;\n\t\tMETALLIC = metallic;\n\t\tSPECULAR = specular;\n\t} else {\n\t\tvec2 t = UV * vec2(44.0, 30.0);\n\t\tvec2 weave_cell = floor(t);\n\t\tfloat across = step(0.5, fract((weave_cell.x + weave_cell.y) * 0.5));\n\t\tvec2 f = fract(t);\n\t\tfloat thread = mix(0.5 + 0.5 * sin(f.x * 6.2832), 0.5 + 0.5 * sin(f.y * 6.2832), across);\n\t\tvec2 fw = fwidth(t);\n\t\tfloat near = clamp(1.0 - max(fw.x, fw.y) * 1.4, 0.0, 1.0);\n\t\tfloat mottle = noise(wp.xz * 4.0 + lp.xy * 6.0) * 0.6 + noise(wp.xz * 13.0) * 0.4;\n\t\tvec3 col = tone.rgb * (0.86 + 0.22 * (thread - 0.5) * near) * (0.84 + 0.3 * mottle);\n\t\t// Dirt toward the bottom of the bag.\n\t\tfloat low = 1.0 - smoothstep(0.0, 0.13, lp.y);\n\t\tcol = mix(col, col * 0.58 + vec3(0.05, 0.04, 0.025), low * 0.55);\n\t\t// Wet patches and rain.\n\t\tfloat patch = smoothstep(0.6, 0.82, noise(wp.xz * 1.4 + vec2(wp.y * 2.0, 0.0)));\n\t\tfloat wetness = clamp(wet + patch * 0.75 + zh_wetness * 0.7, 0.0, 1.0);\n\t\tcol *= mix(1.0, 0.6, wetness);\n\t\t// Salt bloom: pale speckles where the bag dried out.\n\t\tfloat bloom = smoothstep(0.84, 0.97, noise(wp.xz * 23.0 + vec2(wp.y * 17.0, lp.x * 11.0))) * (1.0 - wetness) * (0.4 + 0.6 * low);\n\t\tcol = mix(col, vec3(0.74, 0.72, 0.66), bloom * 0.55);\n\t\t// Seam stitches and the tear.\n\t\tfloat stitch = 0.55 + 0.45 * step(0.5, fract(UV.x * 90.0));\n\t\tcol *= 1.0 - 0.35 * COLOR.g * stitch;\n\t\tcol = mix(col, vec3(0.2, 0.16, 0.11), COLOR.r * smoothstep(0.25, 0.6, noise(UV * vec2(60.0, 40.0))) * 0.9);\n\t\tALBEDO = col;\n\t\tROUGHNESS = mix(0.96, 0.6, wetness);\n\t\tSPECULAR = 0.3;\n\t}\n}\n",
   "instanced": false,
   "key": "",
   "kind": "spot_schatten",
   "shader": ""
  },
  {
   "code": "\nshader_type spatial;\nrender_mode cull_disabled;\n// Height-field ground (hill, quarry ridge): grass / dry litter / earth on\n// gentle slopes, rock on steep faces (procedural, like the rock shader).\nuniform int kind = 0;\nuniform sampler2D grass_texture : source_color, filter_linear_mipmap_anisotropic, repeat_enable;\nuniform sampler2D litter_texture : source_color, filter_linear_mipmap_anisotropic, repeat_enable;\nuniform sampler2D earth_texture : source_color, filter_linear_mipmap_anisotropic, repeat_enable;\nuniform vec3 rock_colour = vec3(0.47, 0.45, 0.41);\nuniform float rock_from = 0.62; // normal.y below ‚Üí rock\nuniform float rock_bias = 0.0; // > 0: more rock (quarry)\nuniform vec3 scene_colour = vec3(1.0);\nvarying vec3 wpos;\nvarying vec3 wnrm;\nfloat hash(vec3 p) { p = fract(p * 0.3183099 + 0.1); p *= 17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); }\nfloat noise(vec3 x) {\n\tvec3 i = floor(x); vec3 f = fract(x); f = f * f * (3.0 - 2.0 * f);\n\treturn mix(mix(mix(hash(i), hash(i + vec3(1, 0, 0)), f.x), mix(hash(i + vec3(0, 1, 0)), hash(i + vec3(1, 1, 0)), f.x), f.y),\n\t\tmix(mix(hash(i + vec3(0, 0, 1)), hash(i + vec3(1, 0, 1)), f.x), mix(hash(i + vec3(0, 1, 1)), hash(i + vec3(1, 1, 1)), f.x), f.y), f.z);\n}\nfloat hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }\nfloat noise(vec2 x) { vec2 i = floor(x); vec2 f = fract(x); f = f * f * (3.0 - 2.0 * f);\n\treturn mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y); }\nvoid vertex() {\n\twpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;\n\twnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);\n}\nuniform vec3 light_dir = vec3(-0.525, 0.669, 0.525); // towards the F6/F5 sun\nuniform float relief = 1.25; // exaggerated hill shading for the steep 75¬∞ camera\n// Sunken bank: wet mud at the water line ‚Üí earth ‚Üí grass at the top (UV.y).\nvoid bank(vec2 uv, inout vec3 albedo, inout float roughness) {\n\tvec2 p = wpos.xz;\n\tfloat h = clamp(uv.y + (noise(p * 0.9) - 0.5) * 0.35, 0.0, 1.0);\n\tvec3 mud = texture(earth_texture, p * 0.3).rgb * vec3(0.42, 0.38, 0.33);\n\tvec3 earth = texture(earth_texture, p * 0.24).rgb * 0.82;\n\tvec3 grass = mix(texture(grass_texture, p * 0.125).rgb, texture(litter_texture, p * 0.16).rgb, 0.35);\n\tvec3 col = mix(mud, earth, smoothstep(0.12, 0.45, h));\n\tcol = mix(col, grass, smoothstep(0.7, 1.0, h) * 0.55);\n\talbedo = col * scene_colour;\n\troughness = mix(0.35, 0.95, smoothstep(0.05, 0.4, h));\n}\nvoid fragment() {\n\tif (kind == 1) {\n\t\tvec3 albedo = vec3(0.0);\n\t\tfloat roughness = 1.0;\n\t\tbank(UV, albedo, roughness);\n\t\tALBEDO = albedo;\n\t\tROUGHNESS = roughness;\n\t} else {\n\t\tvec2 p = wpos.xz;\n\t\tfloat n = noise(wpos * 0.9) * 0.55 + noise(wpos * 2.7) * 0.45;\n\t\tvec3 grass = mix(texture(grass_texture, p * 0.125).rgb, texture(grass_texture, p * 0.071 + 0.3).rgb, 0.45);\n\t\tvec3 litter = texture(litter_texture, p * 0.16).rgb * 0.92;\n\t\tvec3 earth = texture(earth_texture, p * 0.24).rgb * 0.85;\n\t\tvec3 soil = mix(grass, litter, smoothstep(0.55, 0.8, n) * 0.55);\n\t\tsoil = mix(soil, earth, smoothstep(0.55, 0.9, 1.0 - wnrm.y + n * 0.25 + rock_bias * 0.45));\n\t\tfloat steep = smoothstep(rock_from + 0.06, rock_from - 0.06, wnrm.y - (n - 0.5) * 0.18 - rock_bias * 0.5);\n\t\tfloat strata = sin((wpos.y + n * 0.6) * 4.2) * 0.5 + 0.5;\n\t\t// Fresh rock: light, vertical drill/blast streaks, darker joints.\n\t\tfloat streak = noise(vec3((wpos.x + wpos.z) * 2.3, wpos.y * 0.35, 0.0));\n\t\tfloat band = smoothstep(0.35, 0.65, sin(wpos.y * 3.1 + n * 1.5) * 0.5 + 0.5);\n\t\tvec3 rock = rock_colour * (0.9 + 0.06 * strata + 0.0 * band) * (0.8 + 0.34 * streak);\n\t\trock *= 1.0 - (1.0 - smoothstep(0.0, 0.03, abs(noise(wpos * vec3(0.9, 3.2, 0.9)) - 0.5))) * 0.22;\n\t\tvec3 colour = mix(soil, rock, steep);\n\t\t// Lit crests, darker feet (reads as height from above).\n\t\tcolour *= mix(0.86, 1.07, smoothstep(0.0, 7.0, wpos.y));\n\t\t// Hill shade: slopes facing the sun lighter, the others darker.\n\t\tvec3 ne = normalize(vec3(wnrm.x * 2.4, wnrm.y, wnrm.z * 2.4));\n\t\tfloat shade = clamp(dot(ne, normalize(light_dir)) * 0.55 + 0.6, 0.66, 1.14);\n\t\tcolour *= mix(1.0, shade, relief);\n\t\tALBEDO = colour * scene_colour;\n\t\tROUGHNESS = 0.92;\n\t}\n}\n",
