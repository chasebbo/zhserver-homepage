   "kind": "spot_schatten",
   "shader": ""
  },
  {
   "code": "\r\nshader_type spatial;\r\nrender_mode cull_disabled;\r\nuniform sampler2D skin : source_color, filter_linear_mipmap_anisotropic;\r\nuniform vec3 paint = vec3(0.8);\r\nuniform vec3 scene_colour = vec3(1.0);\r\nuniform float gloss = 0.5;\r\n// Photo atlases (Block 12): same exposure as the police SUV's photo\r\n// material (albedo √ó 0.66‚Äì0.69 in goldstandard_vehicle_study.gd).\r\nuniform float photo_gain = 1.0;\r\nvoid fragment() {\r\n\tvec4 t = texture(skin, UV);\r\n\tif (t.a < 0.39) { discard; }\r\n\tfloat p = clamp((1.0 - t.a) / 0.3412, 0.0, 1.0);\r\n\tvec3 col = mix(t.rgb, t.rgb * paint / 0.8, p);\r\n\tfloat brightest = max(col.r, max(col.g, col.b));\r\n\tfloat glass = (1.0 - p) * step(t.r + 0.012, t.b) * (1.0 - smoothstep(0.30, 0.48, brightest));\r\n\tALBEDO = col * photo_gain * scene_colour;\r\n\tROUGHNESS = mix(mix(0.9, 1.0 - gloss, p), 0.12, glass);\r\n\tSPECULAR = mix(0.38, 0.62, glass);\r\n\tMETALLIC = 0.14 * p;\r\n}\r\n",
