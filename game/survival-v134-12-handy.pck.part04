â‹bLÉšyM½ùÒf—Ž™ú¦ï¢Q‹õ¬/ÅË]:p|Y¯cŠ¼7sn'b]ÇQG˜žßÿŸšA*r c}ÜùÈ¼³ÙÝßøSÚÚ#zmi˜ÖjFÈúúënòÖ9´(s=Ìz9YsS»~8¿/Xýcd_é‹ÊíãómX{»!Ï‘|”ˆVàzJ„†º€Ðì•Æ~ä‰ôI´‡u­õq£Ä¥-<“ëµÛV>7®ÇE;r„Ã§b¾9M`®°h­á“‘"†Ño{Þº:ËÃE;9û.-Æx¿ÿzÿ¯=Gé*N’ä±¢oè× >2¡Þ¨;ãÿx	}RiÎ‹ñø%ùÊ©Sç’‘.?WìükvfºyG(„î?ˆ'ÒøÃ\ô«¾ˆÿ¡ôÏó´Ù×c~ÃÁRö¾-E|aÁH Óp<:ÃŸZ½g?ç•ªsËç÷òQó½ˆ‚u\7BÎm"û¦r…k[Á‰»õR»D>¤»wù/ª]·b‡á¢îÕrõƒn±“rª^)é–Ñé¡§ ¿ƒÓŠXúe	¦G—_we^áoÿ¦Áú¤'ôvø–g!e0ðU|(­’æã¡ÉVg¾¯±ôÅ¸.ãbÚ<ÿ¶ ¿s¾Zº™¤pöÜ5o½hÃFMneÖza
n•loãv’^c¬ëâÒg¿–@óSM1?³Ÿžm"çyFÖß˜ýÀž´“	úyê:^JÑ>õfðåpò–üË­?’©Ø1~|U¸fE3¬ùºóV,÷œý#vœÛ=ûò)Ý?9kþÏ7Ìàû‘È^´32¨ñî<wøÕžlŒþb>âï¹öìÁ¿ô#i}WÜ%w0¾#ßN›;Ÿ¢¡ù[3 þ_~ÛÞå°ŸË␀¾ELq|Á°ïç1À“°­ºör•|Ìïû~Ýs3ï©“µîî%gšo‚~òøï(ÛŸo½Î½_ç¶öCß™ÈWÎäMþÍRÍ·”Š=6Ü¯-üË␀␀␀shader_type spatial;
render_mode cull_back;

// Block 19: torn clothing as a real shell around the zombie body: the same
// skinned mesh pushed out along the normal (1â€“1.5 cm) and cut by the masks
// of zombie_skin.gdshader â€“ shirt where r <= sleeve, trousers where
// 0 < g <= pants_len. Rips follow the baked rest-space noise plus a fine
// fabric noise; they grow towards the hems, the cloth darkens and frays at
// the tear edges, blood and dirt soak in.
uniform vec3 shirt_colour : source_color = vec3(0.45, 0.47, 0.5);
uniform vec3 pants_colour : source_color = vec3(0.2, 0.26, 0.38);
uniform float shirt_on = 1.0;
uniform float sleeve = 0.45; // 0.3 sleeveless â€¦ 0.98 long sleeves
uniform float pants_len = 0.92; // 0.45 shorts â€¦ 0.92 long
uniform int shirt_style = 0; // 0 plain, 1 plaid, 2 hi-vis, 3 camo, 4 Flecktarn (Block 20)
uniform int pants_style = 0; // 0 denim, 1 work cloth, 2 camo, 3 Flecktarn (Block 20)
uniform float coat_len = 0.0; // Block 20: > 0 = coat (shirt colour) down the legs to this leg coordinate
uniform float tear : hint_range(0.0, 1.0) = 0.4;
uniform float blood : hint_range(0.0, 1.0) = 0.5;
uniform float dirt : hint_range(0.0, 1.0) = 0.5;
uniform float gaunt = 0.008;
uniform float seed = 0.0;
// Neutral defaults keep the accepted zombie look. wear 1 = months of wear
// (faded, greyed, deep folds); extra = additional thickness (vests).
uniform float wear : hint_range(0.0, 1.0) = 1.0;
uniform float extra = 0.0;
uniform float pants_from = 0.0; // > 0: legs only from here (boots shell)

varying vec4 mask;

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float noise(vec2 x) {
	vec2 i = floor(x);
	vec2 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
}

vec3 camo(vec2 uv) {
	float a = noise(uv * 48.0 + seed);
	float b = noise(uv * 80.0 + 7.0 + seed);
	vec3 col = vec3(0.3, 0.31, 0.24);
	col = mix(col, vec3(0.22, 0.2, 0.16), step(0.56, a));
	col = mix(col, vec3(0.12, 0.12, 0.11), step(0.66, b));
	return mix(col, vec3(0.38, 0.36, 0.3), step(0.74, a * 0.6 + b * 0.4));
}

// Block 20: Bundeswehr Flecktarn (same dot recipe as character_gear.gd's accepted camo) on the cloth's UV â€“
// fixed on the fabric, never swims. Seit 12.11.2026 aus einem gebackenen Bild (tools/flecktarn_backen.gd,
// dieselbe Rechnung Ã¼ber UV 0 bis 1,37): die vier Rauschschichten kosteten den Browser je Programmfassung
// 1,1 bis 1,6 s Ãœbersetzungszeit, mit dem Bild 0,36 bis 0,57 s (validation/spielabend-12-11).
uniform sampler2D flecktarn_tex : filter_linear, repeat_disable;
const float FLECKTARN_SPAN = 1.37;
vec3 flecktarn(vec2 uv) {
	return texture(flecktarn_tex, uv / FLECKTARN_SPAN).rgb;
}

void vertex() {
	mask = COLOR;
	float limb = (COLOR.r < 0.99 || (COLOR.g > 0.0 && COLOR.g < 0.93)) ? 1.0 : 0.0;
	float is_shirt = (shirt_on > 0.5 && COLOR.r <= sleeve + 0.03) ? 1.0 : 0.0;
	float is_pants = (COLOR.g > max(0.0, pants_from - 0.03) && COLOR.g <= pants_len + 0.03) ? 1.0 : 0.0;
	// Loose cloth: thicker on the torso and thighs, wrinkles from the noise.
	float loose = is_shirt * (COLOR.r < 0.3 ? 0.02 : 0.012) + is_pants * (COLOR.g < 0.45 ? 0.018 : 0.013);
	float thickness = max(is_shirt * 0.011, is_pants * 0.013);
	thickness = max(thickness, loose) + (COLOR.b - 0.5) * 0.012;
	if (coat_len > 0.0 && shirt_on > 0.5 && COLOR.g > 0.0 && COLOR.g < coat_len) {
		thickness += 0.006 + 0.02 * (COLOR.g / coat_len); // the coat flares towards the hem
	}
	VERTEX += NORMAL * (thickness + extra - gaunt * limb);
}

void fragment() {
	float shirt = shirt_on * step(mask.r, sleeve);
	float pants = step(max(0.0001, pants_from), mask.g) * step(mask.g, pants_len);
	if (shirt + pants < 0.5) {
		discard;
	}
	bool on_shirt = shirt > 0.5 && (pants < 0.5 || mask.r < 0.29);
	if (coat_len > 0.0 && shirt_on > 0.5 && mask.g > 0.0 && mask.g < coat_len) {
		on_shirt = true;
	}
	float fine = noise(UV * 95.0 + seed) * 0.55 + noise(UV * 260.0) * 0.45;
	float rip = mask.b * 0.68 + fine * 0.32;
	float hem = on_shirt ? smoothstep(sleeve - 0.12, sleeve, mask.r) : smoothstep(pants_len - 0.14, pants_len, mask.g);
	float limit = 1.0 - tear * 0.55 - hem * tear * 0.6;
	if (rip > limit) {
		discard;
	}
	float edge = smoothstep(limit - 0.09, limit, rip);
	vec3 col;
	if (on_shirt) {
		col = shirt_colour;
		if (shirt_style == 1) {
			float a = step(0.5, fract(UV.x * 70.0));
			float c = step(0.5, fract(UV.y * 70.0));
			col = shirt_colour * (0.62 + 0.2 * a + 0.2 * c);
			col = mix(col, vec3(0.08, 0.07, 0.06), step(0.92, fract(UV.x * 70.0)) * 0.6);
		} else if (shirt_style == 2) {
			float stripe = step(abs(mask.r - 0.115), 0.012) + step(abs(mask.r - 0.205), 0.012) + step(abs(mask.r - 0.72), 0.02);
			col = mix(col, vec3(0.72, 0.74, 0.72), clamp(stripe, 0.0, 1.0));
		} else if (shirt_style == 3) {
			col = camo(UV);
		} else if (shirt_style == 4) {
			col = flecktarn(UV);
		}
		col *= 0.92 + 0.08 * noise(UV * 400.0);
	} else {
		col = pants_colour;
		if (pants_style == 0) {
			col *= 0.88 + 0.12 * sin((UV.x + UV.y) * 1400.0);
			col = mix(col, col * 1.35, smoothstep(0.6, 0.95, noise(UV * 22.0 + seed)) * 0.5); // faded denim
		} else if (pants_style == 2) {
			col = camo(UV + 0.37);
		} else if (pants_style == 3) {
			col = flecktarn(UV + 0.37);
		} else {
			col *= 0.9 + 0.1 * noise(UV * 300.0);
		}
	}
	float n = noise(UV * 26.0 + seed * 2.0);
	// Worn for months: faded, greyed, grimy.
	float grey = dot(col, vec3(0.3, 0.59, 0.11));
	col = mix(col, mix(col, vec3(grey), 0.28) * 0.86, wear);
	// Dirt soaks up from the ground and gathers in patches.
	float d = dirt * (smoothstep(0.35, 0.95, mask.g) * 0.8 + 0.35 * smoothstep(0.55, 0.9, n));
	col = mix(col, vec3(0.2, 0.16, 0.11), clamp(d, 0.0, 0.85));
	// Blood: dried brown on the cloth, fresher near wounds and the collar.
	float b = smoothstep(0.3, 0.7, mask.a + n * 0.3) * blood;
	col = mix(col, mix(vec3(0.2, 0.05, 0.03), vec3(0.3, 0.04, 0.03), n), b);
	// Folds: darker in the creases of the wrinkle noise.
	col *= mix(1.0, 0.82 + 0.18 * smoothstep(0.25, 0.75, mask.b), 0.4 + 0.6 * wear);
	col *= 1.0 - edge * 0.45;
	ALBEDO = col;
	ROUGHNESS = mix(0.93, 0.5, b * 0.6);
	SPECULAR = 0.2;
}
shader_type spatial;
render_mode cull_back;

// Block 19: decayed zombie skin over the CC0 Universal Base Characters body
// (Quaternius). The vertex colour carries masks baked from the rest pose by
// zombie_3d.gd: r = upper-body coordinate (torso 0â€“0.3, arm 0.3â€“1, else 1),
// g = leg coordinate (0 above the waist, waist â†’ ankle 0â€“0.93, foot > 0.93),
// b = rest-space noise, a = blood/wound mask.
uniform sampler2D albedo_tex : source_color, filter_linear_mipmap;
uniform sampler2D normal_tex : hint_normal, filter_linear_mipmap;
uniform sampler2D rough_tex : hint_default_white, filter_linear_mipmap;
uniform vec3 skin_tint : source_color = vec3(0.66, 0.7, 0.58);
uniform float decay : hint_range(0.0, 1.0) = 0.6;
uniform float gaunt = 0.008; // m inwards on torso, arms, legs
uniform float blood : hint_range(0.0, 1.0) = 0.6;
uniform float dirt : hint_range(0.0, 1.0) = 0.5;
uniform vec3 shoe_colour : source_color = vec3(0.13, 0.11, 0.09);
uniform float shoes : hint_range(0.0, 1.0) = 1.0;
uniform float seed = 0.0;

varying vec4 mask;

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float noise(vec2 x) {
	vec2 i = floor(x);
	vec2 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
}

void vertex() {
	mask = COLOR;
	float limb = (COLOR.r < 0.99 || (COLOR.g > 0.0 && COLOR.g < 0.93)) ? 1.0 : 0.0;
	VERTEX -= NORMAL * gaunt * limb;
}

void fragment() {
	vec3 base = texture(albedo_tex, UV).rgb;
	float lum = dot(base, vec3(0.3, 0.59, 0.11));
	float n = noise(UV * 34.0 + seed) * 0.6 + noise(UV * 120.0 + seed * 3.0) * 0.4;
	// Bloodless, greyed skin with a sickly tint; the painted anatomy stays.
	vec3 dead = mix(vec3(lum), base, 0.3) * skin_tint * 0.92;
	// Mottled decay: rotting grey-green patches and purple-brown bruising.
	float patches = smoothstep(0.5, 0.82, mask.b * 0.75 + n * 0.4) * decay;
	vec3 rot = mix(vec3(0.34, 0.37, 0.24), vec3(0.3, 0.2, 0.24), step(0.55, fract(mask.b * 9.0 + seed)));
	dead = mix(dead, rot, patches * 0.75);
	// Dark sunken areas (eye sockets, creases) from the baked shading.
	dead *= mix(1.0, smoothstep(0.05, 0.5, lum) * 0.5 + 0.55, decay * 0.6);
	// Black underwear of the base body stays dark cloth.
	float cloth = 1.0 - smoothstep(0.07, 0.15, lum);
	vec3 col = mix(dead, base * 0.85, cloth);
	// Blood: mouth/chin, hands, wounds; wet where fresh.
	float b = smoothstep(0.32, 0.72, mask.a + n * 0.28) * blood;
	col = mix(col, mix(vec3(0.16, 0.04, 0.03), vec3(0.26, 0.04, 0.02), n), b);
	// Dirt from the ground up the legs.
	float d = smoothstep(0.45, 1.0, mask.g) * dirt * (0.45 + 0.55 * n);
	col = mix(col, vec3(0.2, 0.16, 0.11), d);
	// Worn shoes on the feet (or bare, filthy feet).
	float shoe = step(0.935, mask.g) * shoes;
	col = mix(col, shoe_colour * (0.75 + 0.45 * n), shoe);
	ALBEDO = col;
	float r = texture(rough_tex, UV).g;
	ROUGHNESS = mix(mix(r, 0.9, 0.35), 0.3, b * 0.7);
	SPECULAR = 0.3;
	NORMAL_MAP = texture(normal_tex, UV).rgb;
}
