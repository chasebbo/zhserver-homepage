render_mode cull_back;

// Block 20: living human skin over the CC0 Universal Base Characters body
// (Quaternius) for the player and the NPCs (human_3d.gd). Same vertex-colour
// masks as the zombie (zombie_3d.gd bake_masks): r = upper-body coordinate,
// g = leg coordinate (> 0.935 = feet), b = rest-space noise. The painted
// anatomy of the source texture stays; skin_tone shifts it between light and
// dark complexions, the base body's black underwear stays dark cloth, feet
// get shoes/boots.
uniform sampler2D albedo_tex : source_color, filter_linear_mipmap;
uniform sampler2D normal_tex : hint_normal, filter_linear_mipmap;
uniform sampler2D rough_tex : hint_default_white, filter_linear_mipmap;
uniform vec3 skin_tone : source_color = vec3(0.86, 0.68, 0.56);
uniform float tone_mix : hint_range(0.0, 1.0) = 0.55;
uniform vec3 shoe_colour : source_color = vec3(0.12, 0.1, 0.08);
uniform float shoes : hint_range(0.0, 1.0) = 1.0;
uniform float boots : hint_range(0.0, 1.0) = 0.0; // 1: shoe band up the shin
uniform float dirt : hint_range(0.0, 1.0) = 0.0;

varying vec4 mask;

void vertex() {
	mask = COLOR;
}

void fragment() {
	vec3 base = texture(albedo_tex, UV).rgb;
	float lum = dot(base, vec3(0.3, 0.59, 0.11));
	// Complexion: the painted shading times the chosen tone.
	vec3 skin = mix(base, vec3(lum) * skin_tone * 1.4, tone_mix);
	float cloth = 1.0 - smoothstep(0.07, 0.15, lum);
	vec3 col = mix(skin, vec3(0.06, 0.06, 0.065), cloth);
	float shoe = step(mix(0.935, 0.86, boots), mask.g) * shoes;
	col = mix(col, shoe_colour * (0.85 + 0.3 * mask.b), shoe);
	col = mix(col, vec3(0.2, 0.16, 0.11), smoothstep(0.7, 1.0, mask.g) * dirt * 0.5);
	ALBEDO = col;
	float r = texture(rough_tex, UV).g;
	ROUGHNESS = mix(r, 0.75, shoe * 0.6);
	SPECULAR = 0.35;
	NORMAL_MAP = texture(normal_tex, UV).rgb;
	NORMAL_MAP_DEPTH = 0.45; // the painted muscle relief stays subtle
}
