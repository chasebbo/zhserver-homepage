   "code": "\nshader_type spatial;\nrender_mode cull_disabled;\nglobal uniform float zh_wind;\nglobal uniform float zh_night;\nvarying vec4 custom;\nvarying float head;\nvarying float hgt;\nvoid vertex() {\n\tvec3 wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;\n\tfloat bend = UV.y * UV.y;\n\tfloat sway = sin(TIME * 1.6 + wp.x * 0.37 + wp.z * 0.29) * (0.025 + 0.07 * zh_wind);\n\tVERTEX.x += sway * bend;\n\tVERTEX.z += sway * 0.6 * bend;\n\tcustom = INSTANCE_CUSTOM;\n\thead = UV.x;\n\thgt = UV.y;\n}\nvoid fragment() {\n\tvec3 tip = custom.rgb;\n\tvec3 c = mix(tip * 0.34, tip, hgt);\n\tif (custom.a > 0.9) {\n\t\tc = mix(mix(vec3(0.07, 0.11, 0.05), vec3(0.2, 0.3, 0.11), hgt), tip, step(0.5, head));\n\t\t// E25 (Sebastian 6.11.2026): nachts sahen die hellen Bl√ºtenk√∂pfe wie Augen aus.\n\t\tif (head > 0.5) {\n\t\t\tfloat grey = dot(c, vec3(0.3, 0.6, 0.1));\n\t\t\tc = mix(c, mix(vec3(grey), vec3(0.2, 0.3, 0.11), 0.55) * 0.42, zh_night);\n\t\t}\n\t} else if (custom.a > 0.5) {\n\t\tc = tip;\n\t}\n\tALBEDO = c;\n\tROUGHNESS = 0.92;\n\tSPECULAR = 0.18;\n}\n",
   "instanced": true,
   "key": "",
   "kind": "spot_schatten",
   "shader": ""
  },
