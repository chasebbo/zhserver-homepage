r␀∫{«˘}Ω^”›JÁ,d¬6Ú˚ÔÈ7f•y.:äπﬁFõ÷iﬁs‚û·a≤±e/å‹Û;˘≈»⁄.?ÃûælÙZªÒÍv i2ê◊ ∆˛¶ÖH‰ﬁKÜÕ|≈b®¡¿òsƒkôoJ7ñÏ“béØ!Ê›“≈∆◊	`Íπ␀€ÇI,O7∂äÉø⁄é©Óò	dNª«ö±jç∏…ÕÄÔx÷Ú¿∂í‚=|IYÙ	ˇ‡ ◊·E…¢«ÇÓâ⁄«¥ÿO©9?Ì}áG˚òÑoÜ√/ú1ïóˇ*8êæiù)Nlö◊`4OÎÍ˚úz -D˝¬+ûoG»H?ç{hÎbˇxß∑ãZ*!S¯◊RFzÚ¢¸yûqÂ:ºd€åÆ{hÇbÔ}…ãÈû˘Zm™ãn[—[KY…monyˇÏ€h†Ö€j˛*îS^Ô’]ùwPëó—;wª€≤G+zÙıº ﬂ2Ú$û—¬¢¸lÿ·]yéø≥´hﬂÚìp≠ìé™ßÔá∏ﬂ'‰Ù∑ÓVÕl∞ﬁ£‡≈,Ü∂[]ØÈÃzV<CíÛ09â`Ò∏ΩàÙ≠–£c‡øMÊõ˜sÄÔú√1ØˇÒÓ”ıÕqP˚ZK^»ø∂˘ˆÙΩ3LÈ‹ˆÀÈâµÀø9ﬂ?˚ƒ®ßÑU⁄˝§ˇ-ømˇ¸ò¸ùË[¥ﬂÍ9¨ß∞3{pˇœ¡˜3˙˝„§âÈy~÷ã≤å∫óæy?™‡/˛RMıù¡˘—µ*ÚÁß=èè¢93ZÁíãm`ßLo·_$óSKΩkïçÜwÏz¡O†.P^k‰\“á]ænπî?©≈ëˇû?√õ¨œô∆m˙ÚŒ›ß{¡{Ÿ·Ÿ$è”≠9h«ÕG4ööÁ«fbﬂõw§-„’≤ÁÎÅ8ÂaÆïOOºâ˙l6YœÁ¥˚œw~ù¬ÿ‘†ˆ8˘ä?ñ˝∂˘.À]Wq2P␀␀␀shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, specular_disabled; // Aufgabe A: SPECULAR = 0 anyway

// GAME trees as MultiMesh billboards (tools/goldstandard_world.gd
// build_game_trees). INSTANCE_CUSTOM.a = opacity per tree: 1 normal, lower
// while a figure stands behind the crown. Chopped trees are scaled to zero.
uniform sampler2D native_texture : source_color, filter_linear_mipmap_anisotropic;
uniform float albedo_scale = 0.74;
uniform vec3 native_colour = vec3(1.0);
varying float opacity;

void vertex() {
	opacity = INSTANCE_CUSTOM.a;
	vec3 s = vec3(length(MODEL_MATRIX[0].xyz), length(MODEL_MATRIX[1].xyz), length(MODEL_MATRIX[2].xyz));
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0] * s.x, INV_VIEW_MATRIX[1] * s.y, INV_VIEW_MATRIX[2] * s.z, MODEL_MATRIX[3]);
}

void fragment() {
	vec4 native = texture(native_texture, UV);
	if (native.a < 0.018) {
		discard;
	}
	ALBEDO = native.rgb * albedo_scale * native_colour;
	ALPHA = native.a * opacity;
	ROUGHNESS = 1.0;
	SPECULAR = 0.0;
	NORMAL = normalize(mat3(VIEW_MATRIX) * vec3(0.0, 1.0, 0.0));
}
