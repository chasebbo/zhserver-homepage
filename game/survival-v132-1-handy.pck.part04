ý1LÚ†Á·`b+^h…<MáÚk¸âLÚéƒp=ûŠfúü€ÉÚÛ7†‚üÁÞîþ­\FŒÐƒóí&¨ÝÛ­r	ˆõŸðã½Côî¯“´Ö'åO¹óÚ÷›—«óŠ·ŸÏp”ª›õP¶yð‡·‹c®S{Ñê‰Ù9ç}DúÌª›‹ãÄ¡ÌQ=!ÎM¼¾Å6MGrl¨½1GQî¡ÎÍ¿ÝÇò†å`±'w=€­ÄâÇù§,3áF)ù@4Êß˜úvO-É©_ä¾Ÿ¢öÚIèŸ”H.™'z¹6XSòQv.Þzù­[ýó€v^¾aªç½Àè¾}ó/¶ÙíÃ{;</r31îVZÎM­“C¥ŸÁçûQ;t—p2Býã¯\¹␀␀␀shader_type spatial;
render_mode unshaded, blend_mix, depth_draw_never, cull_disabled;
uniform float opacity = 0.32;
void fragment() {
    vec2 p = (UV - vec2(0.5)) * 2.0;
    float radius = length(p);
    ALBEDO = vec3(0.045, 0.036, 0.026);
    ALPHA = pow(max(0.0, 1.0 - radius), 1.45) * opacity;
}
␀␀␀shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, specular_disabled; // Aufgabe A: SPECULAR = 0 anyway

uniform sampler2D native_texture : source_color, filter_linear_mipmap_anisotropic;
uniform float albedo_scale = 0.74;
uniform vec3 native_colour = vec3(1.0);
// 1 = opaque artwork (default everywhere); the GAME slice lowers it for a GAME
// tree crown while a figure stands behind it.
uniform float opacity : hint_range(0.0, 1.0) = 1.0;

void vertex() {
	// Same camera-facing plane and authored foot offset as Sprite3D. Only the
	// local study's material changes; world anchors and artwork remain native.
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0], INV_VIEW_MATRIX[1], INV_VIEW_MATRIX[2], MODEL_MATRIX[3]);
}

void fragment() {
	vec4 native = texture(native_texture, UV);
	if (native.a < 0.018) { discard; }
	ALBEDO = native.rgb * albedo_scale * native_colour;
	ALPHA = native.a * opacity;
	ROUGHNESS = 1.0;
	SPECULAR = 0.0;
	// Authored steep-view diffuse already describes each object's facets.
	// An upward lighting normal lets actual sunlight, lamp positions and shadow
	// maps illuminate the image coherently with the orthogonal ground plane.
	NORMAL = normalize(mat3(VIEW_MATRIX) * vec3(0.0, 1.0, 0.0));
}
␀shader_type spatial;
render_mode cull_disabled, depth_draw_never;
uniform sampler2D surface_texture : source_color, filter_linear_mipmap;
uniform vec4 tint : source_color = vec4(1.0);
uniform float opacity = 0.7;
void fragment() {
	vec4 colour = texture(surface_texture, UV);
	float border = min(min(UV.x, 1.0 - UV.x), min(UV.y, 1.0 - UV.y));
	ALBEDO = colour.rgb * tint.rgb;
	ROUGHNESS = 0.96;
	ALPHA = smoothstep(0.01, 0.17, border + (colour.r - 0.3) * 0.09) * opacity;
}
