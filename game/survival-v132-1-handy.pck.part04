ÉuKµžºo¦™6~‚ÇÛ*¦¾žÏPà³øÖ­Z¯EÛbûëªYÕ2p–ŠžÙ¯Ïºiú F…NiM`®g8â´‡÷ž!{Æw÷øYü«|Í¾Ë¬ëÏrôŒ@?_O6‡Ã°è¾DOUàd/Ô¼´{¤G{«n:¦Ø—ú[A6¼Ççû.»›4ç×KïÈ”Z ù+†Úþ|GkŸ‘›‡‡³']ÀO¨ßçßlëXûzkš6òv©Ôiâ9ÅëŒ}%làŽ%ËŽ¹ºx±¨x¨ã_ÉË;Ç§ò£fV¼Ü¶ÿ␀Î™éÕGUØ”¾5&yÞÈw€¼Û{á`6Ôèô4ÝŽ©)ýSþÍ#C‰ãàWØ«´GœýúØ‡u»ÚÅÅÃBÈ-N?}“3&0hüøåÕõŸþ³Ü{™ô‹O‘¨‰Ýé¡GËìÊï§õQÎßFü2ã|¯+R?£2yƒ,­Ó×bäw|âÁø?ñ€|iùU:SickaÙŽSÓ×$¾íXLýqÌs(ÙqÉžï9Y—qÍ‰AaÑÙÝ8+Öðho_ÿÜúÚôþìðÜó¸Ím¥gWÎòF|Ú^␀␀␀␀␀␀␀␀␀shader_type spatial;
render_mode cull_disabled;

// E2.9: waving cloth without physics. The flag mesh lies in local XY with the
// hoist at x = 0 (fixed on the mast) and the fly end at x = flag_length;
// vertices are pushed along local Z by two travelling waves whose amplitude
// grows towards the fly end. Wind (global zh_wind, set from the weather:
// clear â‰ˆ 0.3, overcast â‰ˆ 0.65, rain/storm â‰ˆ 1.1) speeds the waves up,
// raises them and lifts the cloth; in a calm the fly end droops.
uniform sampler2D flag_texture : source_color, filter_linear_mipmap_anisotropic, repeat_disable;
uniform float flag_length = 3.0;
uniform float flag_height = 1.875;
uniform float wave_amp = 0.16;
uniform float wave_freq = 3.4;
uniform float wave_speed = 3.2;
uniform float phase_offset = 0.0;
global uniform float zh_wind;
global uniform float zh_wetness;

varying float fold;

float waves(float x, float y, float t, float amp) {
	return amp * (sin(x * wave_freq - t + y * 0.7 + phase_offset) + 0.35 * sin(x * wave_freq * 2.3 - t * 1.7 + 1.3 + phase_offset));
}

void vertex() {
	float wind = clamp(zh_wind, 0.0, 1.6);
	float u = clamp(VERTEX.x / flag_length, 0.0, 1.0);
	float t = TIME * wave_speed * (0.55 + 0.7 * wind);
	float amp = wave_amp * (0.35 + 0.9 * wind) * (0.15 + 0.85 * u);
	float dz = waves(VERTEX.x, VERTEX.y, t, amp);
	float calm = clamp(1.0 - wind, 0.0, 1.0);
	// calm: the fly end sags and the cloth shortens a little
	VERTEX.y -= calm * 0.32 * flag_height * u * u;
	VERTEX.x *= 1.0 - calm * 0.12 * u;
	VERTEX.z += dz;
	float dx = (waves(VERTEX.x + 0.02, VERTEX.y, t, amp) - dz) / 0.02;
	NORMAL = normalize(vec3(-dx, 0.0, 1.0));
	fold = clamp(0.5 + 0.5 * dx, 0.0, 1.0);
}

void fragment() {
	vec4 tex = texture(flag_texture, UV);
	if (tex.a < 0.5) {
		discard;
	}
	float wet = clamp(zh_wetness, 0.0, 1.0);
	ALBEDO = tex.rgb * 0.9 * mix(0.9, 1.03, fold) * (1.0 - 0.2 * wet);
	ROUGHNESS = mix(0.92, 0.7, wet);
}
