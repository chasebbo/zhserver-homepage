render_mode blend_mix, depth_draw_opaque, cull_disabled, specular_disabled; // Aufgabe A: SPECULAR = 0 anyway

// Camera-facing photographic cutout for MultiMesh vegetation (grass, shrubs,
// litter): like goldstandard_cutout.gdshader, but keeps each instance's scale
// so thousands of plants share one material and one draw call per kind.
uniform sampler2D native_texture : source_color, filter_linear_mipmap_anisotropic;
uniform float albedo_scale = 0.74;
uniform vec3 native_colour = vec3(1.0);

void vertex() {
	vec3 s = vec3(length(MODEL_MATRIX[0].xyz), length(MODEL_MATRIX[1].xyz), length(MODEL_MATRIX[2].xyz));
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0] * s.x, INV_VIEW_MATRIX[1] * s.y, INV_VIEW_MATRIX[2] * s.z, MODEL_MATRIX[3]);
}

void fragment() {
	vec4 native = texture(native_texture, UV);
	if (native.a < 0.3) {
		discard;
	}
	ALBEDO = native.rgb * albedo_scale * native_colour;
	ROUGHNESS = 1.0;
	SPECULAR = 0.0;
	NORMAL = normalize(mat3(VIEW_MATRIX) * vec3(0.0, 1.0, 0.0));
}
