i:#C®Œ™ê'ÒÙ>ò!BÍ=Þ› ºö˜:iì‰N"V‘(#«æµáb¸ûÚl¹ªþ.3^;KAÇë|8®èè²NÓ_ÙàÄª¤ÒóïMïf]þùk­yã	ûÆ²}Ý§ŠA7É‹ÀÙÈä:ô#¥Q ÛÖ=qò\OÃ­¢qðÌ¯Ÿ[0eeœÙqê~«3Ü—Èá4ƒú”ŠÎh¾¸çrj²¿¢ÒœåÊâË»>ùuò—i'åÉÝø£Ýê4p}ŠÎ¡¶¨â¤a†	ìÑèYTÞD³LðúÜ)5&ZU@ÚˆXs˜:Ÿqý×v<-Ž¯h‹	íOü}¤¬:?ÜˆÀBwó¿P÷Ã"n¨ù‘ÖS³#ò~qÖus`Ni:ë+äl?#mÉ´7{ÜÀ>,ÎÍÃtâ␀¾±‚†9ûÛ ÎÒà~)úc*æ±Ì1°␀‘8–Y·ÆÚ9Äfq€¨>æÙ£™XfåYÚ¨ÜîË‡9Þ“L¯ÒçTä^!©Ö{7yÛS…ÂÞ=sA#WwùFèÝD‡ý9Þ0£Ó4áeÈ<û-FqkÎÇà‹cÉ°ÜM6øôµläù`iX°.Ý½å’11Ê¡òµXóxãº#[ã”5©âÂðö¦Üh5×¿\îšfvÇáßA¤‹½ˆy~Ëøš(¼l¼åI>"rÃ¶©²â³ñ¾T®3Øµˆ[fV­S›#é~)×uåœ'_␀␀␀␀shader_type spatial;
render_mode cull_disabled;

uniform sampler2D native_texture : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform vec4 colour : source_color = vec4(1.0);
uniform float material_height = 10.0;
uniform float horizontal_scale = 0.16;
uniform float horizontal_offset = 0.0;
uniform float brightness = 0.74;
varying vec3 wall_position;
varying vec3 wall_normal;

void vertex() {
	wall_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wall_normal = normalize(MODEL_NORMAL_MATRIX * NORMAL);
}

void fragment() {
	// Native vertical material has a clean upper wall and a damp lower edge.
	// Keep gravity and the base height consistent across individual source cells.
	float along = abs(wall_normal.x) > abs(wall_normal.z) ? wall_position.z : wall_position.x;
	vec2 uv = vec2(along * horizontal_scale + horizontal_offset, clamp(1.0 - wall_position.y / material_height, 0.004, 0.996));
	if (abs(wall_normal.y) > 0.7) {
		uv = wall_position.xz * horizontal_scale + vec2(horizontal_offset, 0.23);
	}
	vec3 native = texture(native_texture, uv).rgb;
	ALBEDO = native * mix(vec3(1.0), colour.rgb, 0.3) * brightness;
	ROUGHNESS = 0.94;
	SPECULAR = 0.12;
	vec2 pixel = 1.0 / vec2(textureSize(native_texture, 0));
	float h = dot(native, vec3(0.299, 0.587, 0.114));
	float hx = dot(texture(native_texture, uv + vec2(pixel.x, 0.0)).rgb, vec3(0.299, 0.587, 0.114));
	float hy = dot(texture(native_texture, uv + vec2(0.0, pixel.y)).rgb, vec3(0.299, 0.587, 0.114));
	NORMAL_MAP = normalize(vec3((h - hx) * 0.55, (h - hy) * 0.55, 1.0)) * 0.5 + 0.5;
}
