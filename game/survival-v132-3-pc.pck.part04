¶´íë‡Åyð0L Â.¦©Çdt£ßüqåÝ"Rßã2Îá><-ãBËÆæñLO¶ò—¤þ§é›y1þvÛªÆQ³_’áÕûÚYPûž_-¾‘ó—¿¤v¨éÈ1åŸ?xÃw»úûrtBÉ…LÏúñ§½Ó{28øë^ÔT£S“ÀÐäç¾ç,êãÀÓúDŽ£	„Ç»¥ØãHï–`%ŽK/×è ^»Ý¼å\ì›"™9¶tïT2üÅ¬ÿ;8þ8öBö!É.b^ ]Œö]9&çåúúe"žƒÔä64ñxÝÃê-V‡ÝãŠ½“|;Ö␀Ùj> óûZËÔõ!ª˜g
ô—FÃÄ¸©õFT/1Å³|A†û0ù¡çeI{Ã¬DDÄ”væ™qhUšs¶¾!Ô_Ò™VÀ‘Á {-¯o÷W™¿x·èãmï1Óõ}ècû¦mH×ß`ývžÝÐÔ+ÄþÄ¡gâh‘ï•á␀Q^=€NŠÿÝß‚ƒ>÷5Lzº¼Òv‹S3øIzaÜi¶¬¶^óõ9þÛÓýÿ¸©¼°q÷␀shader_type spatial;
render_mode cull_disabled;

// Fixed steep-view native object artwork projected onto a real local body.
// The projection is independent of the shadow camera, so the same physical
// surfaces and alpha silhouette can cast the actual scene's light shadows.
uniform sampler2D native_texture : source_color, filter_linear_mipmap_anisotropic;
uniform vec3 native_origin = vec3(0.0);
uniform float native_width = 1.0;
uniform float native_height = 1.0;
uniform float foot_padding = 0.0;
uniform vec3 native_colour = vec3(0.78);
uniform vec3 photo_up = vec3(0.0, 0.258819, -0.965926);
uniform vec3 photo_right = vec3(1.0, 0.0, 0.0);
varying vec3 world_position;

void vertex() {
	world_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}
void fragment() {
	vec3 relative = world_position - native_origin;
	vec2 uv = vec2(0.5 + dot(relative, photo_right) / native_width, 1.0 - (dot(relative, photo_up) + foot_padding) / native_height);
	if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) { discard; }
	vec4 native = texture(native_texture, uv);
	if (native.a < 0.1) { discard; }
	ALBEDO = native.rgb * native_colour;
	ROUGHNESS = 0.92;
	SPECULAR = 0.12;
	// A little diffuse sky contribution keeps photographic facets readable;
	// most response still follows the physical surface and its received shadows.
	NORMAL = normalize(NORMAL * 0.8 + mat3(VIEW_MATRIX) * vec3(0.0, 0.2, 0.0));
}
