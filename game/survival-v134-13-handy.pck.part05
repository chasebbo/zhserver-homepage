   "key": "StandardMaterial3D,resource_local_to_scene=false,transparency=2,alpha_antialiasing_mode=0,blend_mode=0,cull_mode=2,depth_draw_mode=0,no_depth_test=false,depth_test=0,shading_mode=1,diffuse_mode=0,specular_mode=0,disable_ambient_light=false,disable_fog=false,disable_specular_occlusion=false,vertex_color_use_as_albedo=false,vertex_color_is_srgb=false,albedo_texture=1,albedo_texture_force_srgb=false,albedo_texture_msdf=false,orm_texture=0,metallic_texture=0,metallic_texture_channel=0,roughness_texture=0,roughness_texture_channel=0,emission_enabled=true,emission_operator=0,emission_on_uv2=false,emission_texture=0,normal_enabled=false,normal_texture=0,bent_normal_enabled=false,bent_normal_texture=0,rim_enabled=false,rim_texture=0,clearcoat_enabled=false,clearcoat_texture=0,anisotropy_enabled=false,ao_enabled=false,ao_texture=0,ao_on_uv2=false,ao_texture_channel=0,heightmap_enabled=false,heightmap_deep_parallax=false,heightmap_flip_tangent=false,heightmap_flip_binormal=false,heightmap_texture=0,heightmap_flip_texture=false,subsurf_scatter_enabled=false,subsurf_scatter_skin_mode=false,subsurf_scatter_texture=0,subsurf_scatter_transmittance_enabled=false,subsurf_scatter_transmittance_texture=0,backlight_enabled=false,backlight_texture=0,refraction_enabled=false,refraction_texture=0,refraction_texture_channel=0,detail_enabled=false,detail_blend_mode=0,detail_uv_layer=0,uv1_triplanar=false,uv1_world_triplanar=false,uv2_triplanar=false,uv2_world_triplanar=false,texture_filter=3,texture_repeat=true,disable_receive_shadows=false,shadow_to_opacity=false,billboard_mode=0,billboard_keep_scale=false,particles_anim_loop=false,grow=false,fixed_size=false,use_point_size=false,use_particle_trails=false,use_z_clip_scale=false,use_fov_override=false,proximity_fade_enabled=false,distance_fade_mode=0,stencil_mode=0,stencil_compare=0,metadata/zh_unified=true",
   "kind": "spot_schatten",
   "shader": ""
