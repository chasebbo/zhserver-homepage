Åœêk3ß”v^ÿçÿÌ°¥Pk~}¸Ùú®8Þ‚ƒG¾|¢µ¸>må8X [mÔŒ}Ù³ñc©zùÍø;°ÜÄ~Ÿyƒ Y0:æÞ¡Nñšõ†fLû5YÇíäaÖÉ®êíÍáháÜ«§‹`4†nH>#×bÀ|å¨ýî2Ì%oHçäüü	öˆÞ ý5€ÝyGÂCæ¥›Ñ×‡R‡ÒhÕóÐÑ8©üÄ…¯EÔmj£*Y,x%‹Îù¡Ã¬üÎ´
ØØ¢Ó‹™]”Ÿƒ0âa”Ü$P3À»›@ÎUÑnÑÅÓIÚÛZ¶2»~p ú?ƒª^—ÆpüÓ¢ñUnPþ=DÇX¢,KÆ×7†ï£;ÐýXßxú;uÃàsôÝû\B® äcß¿R~2{þátvÓnªô/`îØC8|Ô·ûoÞï¨nUÜ’÷×þŒ<vÞ#Ïç¦§}D~I™8ÎbåANäXp¢Vf{÷g¸K—¿GÄ’ž8~ë…¼Æ5¸pæã¹áŽð|öAt÷×¬éN‡±ýã9Ý?5šÝ,<Ö‰p#¥gÆ_ñÜüMßþÞÂ¯!‡']Óª?hhn1jsþ‹ì:HÙ—¶rQµs'Wû€ˆ3Ž"æ^CæÖÌ€º'ðß¿B'N¬àÝ¹=ÓÞ_jõ2Øþ]\Ø-Ó€àÿÉô?ûãè¾˜×çCx÷d½ƒKÆ´5u¨ÖKêeÏ§á÷ò½zXîñ+é˜e´ÿ_ô3¿rLžvÿ!“æSúÃhøs8/3Ìÿ½Ù(?Äö$ÞÆ1~D÷dã¡ÚËl¶³ý0´␀x×žöìuÊ¡C8å†çÌ“–:¾»cçý!œ³“{yuÇÈ‡_‚/ÜÆhƒ9¸Ž5¥“ªZ-…}vÃ-öÊÜ‡Þpû½ê–Wì}tÅ¿øú‚5¡æqçÝé/ÚˆÛÂ¶±Æxë]òŒë)«fŸ@6s§æ…ÖuzVŒ3íná‚ËûG8Ëÿ×)ßÀŠ*Í©9þÚ.ÞÉ±£»]&×?`ý¾ñq{É|Bü½¿>^—÷ì[·~NÜ›–ÅºŸOÏÀ2Ï¿™­b“Nwžaðäåçöøw8~ÀzNÓ`!í¨CD;l5p'—ÿR@Džãÿåcïc¿¡jÎ™‹Nµ«zóz¨Kñ%f@oà„õïX|±‡ø␀␀␀␀␀␀␀␀shader_type spatial;
render_mode cull_disabled;

uniform sampler2D native_texture : source_color, filter_linear_mipmap_anisotropic;
uniform vec3 paint_colour = vec3(0.69,0.71,0.72);
uniform float deployment_wear = 0.0;

void fragment() {
	vec4 native = texture(native_texture, UV);
	if(native.a<0.10) { discard; }
	ALBEDO = native.rgb * paint_colour;
	float brightest=max(native.r,max(native.g,native.b));
	float darkest=min(native.r,min(native.g,native.b));
	float grey=1.0-smoothstep(0.045,0.12,brightest-darkest);
	float glass=grey*smoothstep(0.022,0.055,brightest)*(1.0-smoothstep(0.17,0.30,brightest));
	// Photographic colour stays native; coated paint, dark glazing and field
	// abrasion respond differently to actual sky/sun/lamps on the shaped body.
	ROUGHNESS=mix(0.46+deployment_wear*0.21,0.22,glass);
	SPECULAR=mix(0.24,0.54,glass);
	METALLIC=0.10*(1.0-glass);
}
␀␀␀␀shader_type spatial;
render_mode cull_disabled, blend_mix, specular_disabled; // Aufgabe A: SPECULAR = 0 anyway

uniform sampler2D facade_texture : source_color, filter_linear_mipmap_anisotropic;
uniform float window_light = 0.0;
uniform float pane_count = 3.0;
uniform vec4 window_rect = vec4(0.0, 0.15, 1.0, 0.87);

void fragment() {
	vec4 native = texture(facade_texture, UV);
	ALBEDO = native.rgb * 0.72;
	ALPHA = native.a;
	ROUGHNESS = 0.86;
	SPECULAR = 0.06;
	// The authored window has three glass panes. Light their interiors while
	// keeping the actual metal frame, dirt and blinds readable from the photo.
	vec2 glass_uv = (UV - window_rect.xy) / (window_rect.zw - window_rect.xy);
	float pane_x = fract(glass_uv.x * pane_count);
	float glass = smoothstep(0.07, 0.12, pane_x) * (1.0 - smoothstep(0.88, 0.94, pane_x));
	glass *= smoothstep(0.0, 0.08, glass_uv.y) * (1.0 - smoothstep(0.91, 1.0, glass_uv.y));
	glass *= step(0.0, glass_uv.x) * step(glass_uv.x, 1.0);
	float detail = mix(0.62, 1.0, dot(native.rgb, vec3(0.299, 0.587, 0.114)));
	EMISSION = vec3(1.0, 0.55, 0.23) * glass * detail * window_light;
}
