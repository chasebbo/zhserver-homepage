æ÷¡®cWÇ{ß2>èÎîM²wFû}›âÖ¸®•¦HûH½à$zï¹Þ±ØDAsùˆÐWXº“üQçÒ‡Æ–=øf0ï±{ûøÀ€drÐeÒ/ï2<7¶!BÎ#L3MŽµ[BuO¼±y¾;mEäÅ$þªZ'©MÐz°␀óËx÷ ~»ˆÍ~“‡Ni|‹0—w?c½¾á¨Ukm~©°}^hÃO{FÏý`(˜:ñËÄ{©s~Ÿ\~üsœÃ’gâû±>_c7±¥ûi²^âø©ÎM"'©óðd»cåEúûžÀÆ§çîÜãÈïßè›j¯È]öôtßä·°¸Ì8gNÙ‡5´^€÷Uí[û_§õ␀…;ì_Ç=ìÐ;_÷[TT^K¢úŸÑ?°‰¦|ÆÙúþÀ÷[xùæuÇBqaÎ°ÿ‹]*ëL|æém^Kqu²o ù@ÔVŽòtÀçˆo9Zi¨‹¸;´ˆõäˆ'ôÈK¤çÒÐÿxsÕ˜ËXÏÍëiO<v4¼8 65Fµb“Áðöúˆ=àN¾bÏø‡5ÿÄÇÌµG.É7
¼¦Æ'óZ€Õ VóiâHë7kô—õíøOü»z-BK@¾Ãåþ’h¾ ýoº‡>÷LÞ{=ô§æå¨ö»5Ö(E¼t8Gª=_}åTÏ³·»m<úM“®5zF¿M~âñRzã…ƒx“'Ÿ\´Ç#+¨éªÉ¢-¶ïûêÜ9Ãš,B½þì^|¾úÍêÂ{àÂÖé‡\zÿæG$?␀␀shader_type spatial;
render_mode cull_disabled;

// Paket 2, Schritt 3: worn street-prop surface. Base colour or a baked
// albedo (optionally with a paint mask in alpha, tinted by paint_colour),
// plus rust, paint chips, grime and ground dirt from one tileable wear mask
// (prop_wear.png: R rust, G grime, B chips, A variation) projected
// triplanar in world space, so every instance of a shared mesh wears
// differently. Ground dirt rises from world height 0 (the old towns' ground).

uniform sampler2D albedo_texture : source_color, filter_linear_mipmap_anisotropic, repeat_enable, hint_default_white;
uniform bool use_albedo_texture = false;
uniform bool paint_mask = false;
uniform bool alpha_is_height = false;
uniform float height_bump = 0.6;
uniform vec4 base_colour : source_color = vec4(1.0);
uniform vec4 paint_colour : source_color = vec4(0.5, 0.5, 0.5, 1.0);
uniform vec2 uv_scale = vec2(1.0);
uniform sampler2D wear_texture : filter_linear_mipmap, repeat_enable, hint_default_black;
uniform float wear_scale = 1.7;
uniform float rust_amount = 0.0;
uniform float rust_ground = 0.0;
uniform float chip_amount = 0.0;
uniform vec4 chip_colour : source_color = vec4(0.46, 0.46, 0.44, 1.0);
uniform float grime_amount = 0.25;
uniform vec4 grime_colour : source_color = vec4(0.29, 0.26, 0.20, 1.0);
uniform float ground_grime = 0.45;
uniform float ground_height = 0.35;
uniform float ground_level = 0.0; // world height of the ground the object stands on
uniform float dust_amount = 0.25;
uniform vec4 dust_colour : source_color = vec4(0.50, 0.46, 0.38, 1.0);
uniform float metallic_value = 0.0;
uniform float roughness_value = 0.72;
global uniform float zh_wetness;

varying vec3 world_pos;
varying vec3 world_normal;

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	world_normal = normalize(MODEL_NORMAL_MATRIX * NORMAL);
}

vec4 wear_at(vec3 p, vec3 n) {
	vec3 w = pow(abs(n), vec3(4.0));
	w /= (w.x + w.y + w.z + 1e-5);
	return texture(wear_texture, p.zy * wear_scale) * w.x
		+ texture(wear_texture, p.xz * wear_scale + vec2(0.37, 0.11)) * w.y
		+ texture(wear_texture, p.xy * wear_scale + vec2(0.71, 0.53)) * w.z;
}

void fragment() {
	vec2 uv = UV * uv_scale;
	vec4 tex = use_albedo_texture ? texture(albedo_texture, uv) : vec4(1.0);
	vec3 colour;
	float cover = 1.0;
	if (paint_mask) {
		cover = tex.a;
		colour = mix(tex.rgb, paint_colour.rgb * tex.rgb * 2.0, cover);
	} else {
		colour = tex.rgb * base_colour.rgb;
	}
	vec4 wear = wear_at(world_pos, world_normal);
	float low = 1.0 - clamp((world_pos.y - ground_level) / ground_height, 0.0, 1.0);
	float rust_level = rust_amount + rust_ground * low;
	float rust = smoothstep(1.0 - rust_level, 1.0 - rust_level + 0.10, wear.r) * step(0.001, rust_level);
	float chip = smoothstep(1.0 - chip_amount, 1.0 - chip_amount + 0.04, wear.b) * step(0.001, chip_amount) * cover;
	colour = mix(colour, chip_colour.rgb, chip);
	vec3 rust_colour = mix(vec3(0.21, 0.10, 0.05), vec3(0.47, 0.23, 0.10), wear.a);
	colour = mix(colour, rust_colour, rust);
	float grime = clamp(wear.g * grime_amount + low * ground_grime * (0.55 + 0.45 * wear.g), 0.0, 1.0);
	colour = mix(colour, grime_colour.rgb, grime * 0.85);
	float up = smoothstep(0.55, 0.95, world_normal.y);
	colour = mix(colour, dust_colour.rgb, dust_amount * up * (0.35 + 0.65 * wear.g));
	float rough = mix(roughness_value, 0.95, max(rust, grime * 0.7));
	float metal = metallic_value * (1.0 - rust) * (1.0 - grime * 0.8);
	float wet = clamp(zh_wetness, 0.0, 1.0) * mix(0.35, 1.0, up);
	colour *= 1.0 - wet * 0.22;
	ALBEDO = colour;
	ROUGHNESS = mix(rough, 0.35, wet * 0.8);
	METALLIC = metal;
	if (alpha_is_height && use_albedo_texture) {
		vec2 texel = 1.0 / vec2(textureSize(albedo_texture, 0));
		float h0 = tex.a;
		float hx = texture(albedo_texture, uv + vec2(texel.x, 0.0)).a;
		float hy = texture(albedo_texture, uv + vec2(0.0, texel.y)).a;
		NORMAL_MAP = normalize(vec3((h0 - hx) * height_bump * 12.0, (h0 - hy) * height_bump * 12.0, 1.0)) * 0.5 + 0.5;
	}
}
