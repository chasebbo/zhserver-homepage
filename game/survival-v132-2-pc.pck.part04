ü™¿ú.q„Àþ	o`bIÇf>„S1~ßq€[[w©\&©¦Ä|ÉÄ™F‡6ÅÍÈÛ¯OÎÄ\d,ôI§1 ãWâ€N88r“^;ïƒ‡¼íA1þ:)ù(>¥â0¸ýh×À:ïÓíy—5zý˜‡žk¿w+7¸UA_×ä«ä␀ƒ\Xìà?5~¸nJ³PÛ␀:K)6>œõþ0õýÎð=Ä,Žg}„zG'ÏŒn8Ú²?…ð„šHÄjÁ±óin…z[ûîàAøô8°nú2ãÑÍÇ9Œ{ 1¸‰UÉœßÍ{÷/¶Òéeä—ˆcO!ñ§¯\Œž±ÿ»à/ä%“ú&ü^ˆ³¯ÞÞX×¦ÿ‹YC±êæ]ÛEŸwºîkµáþtÛ°ÙîüŒk!ñÃ®™¯(—È}Ñâ}ý‚bp`H,à5±æfä††¦¹“mn␀iþ—;ÀAÓ©’Ü½ÌÛ­'–vÝ2q¸º'œžFX^Ó¯:$Ël§SÚä$Ì–æ–á±ÈüŸ‡‹óz4oïO6/ÿë£_7ì8AÝ ÿæKÚ¹ô¹×ƒ+HIåw7î3ÍQÚ“ïÎiðhV¸z¯…Àëåñ÷š¾ï=w'…æ½Xs·Q™·Ÿ¢ÿ)ê7þgÝvŽWBÇ×·|1ÿ}ó¿—Òÿ}"N~¤Àú6Ò‹xï-.;¨8|˜o­Ø?§£é[šbEw¼D‹*y¾_é`v:žP3ˆ‹2ä9õÏw:æþÏÍt./M™24®œÔ}N}¢þ×ùý?úã›tÂ␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
render_mode cull_disabled;

uniform sampler2D surface_texture : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform vec4 tint : source_color = vec4(1.0);
uniform float tint_strength = 0.35;
uniform vec2 repetitions = vec2(1.0);
uniform float bump_strength = 0.035;
uniform float metalness = 0.0;
uniform float roughness_value = 0.86;
uniform float brightness_value = 1.0;
uniform vec3 scene_colour = vec3(1.0);
global uniform float zh_wetness;
uniform bool world_mapping = false;
uniform vec2 world_scale = vec2(0.4);
uniform sampler2D wear_texture : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform bool use_wear = false;
uniform float wear_amount = 0.55;
uniform bool use_crack_detail = false;
uniform bool edge_enabled = false;
uniform sampler2D edge_texture : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform vec4 edge_rect = vec4(0.0);
uniform vec2 edge_scale = vec2(0.12);
uniform vec3 edge_multiplier = vec3(1.0);
uniform vec4 edge_sides = vec4(1.0);
uniform float edge_width = 1.0;
varying vec3 surface_position;
varying vec3 surface_normal;

void vertex() {
	surface_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	surface_normal = normalize((MODEL_NORMAL_MATRIX * NORMAL));
}
void fragment() {
	vec2 uv = UV * repetitions;
	if (world_mapping) {
		vec3 n = abs(surface_normal);
		uv = (n.y > 0.7 ? surface_position.xz : (n.x > n.z ? vec2(surface_position.z, surface_position.y) : surface_position.xy)) * world_scale;
	}
	vec4 base_colour = texture(surface_texture, uv);
	vec4 colour = base_colour;
	if (use_wear) {
		vec2 broad_uv = surface_position.xz * 0.034;
		vec3 broad = mix(texture(wear_texture, broad_uv).rgb, texture(wear_texture, vec2(-broad_uv.y, broad_uv.x) * 0.73 + vec2(0.17, 0.61)).rgb, 0.34);
		colour.rgb = mix(colour.rgb, broad, wear_amount);
	}
	if (use_crack_detail) {
		// Reuse the native fissures at a larger scale, selecting only their dark
		// features. Fine aggregate keeps its proper scale instead of becoming
		// giant gravel when the whole photograph is enlarged.
		vec3 broad = texture(wear_texture, surface_position.xz * 0.095 + vec2(0.31, 0.77)).rgb;
		float crack = 1.0 - smoothstep(0.012, 0.032, dot(broad, vec3(0.299, 0.587, 0.114)));
		colour.rgb *= mix(1.0, 0.32, crack * 0.72);
	}
	// The authored photographic diffuse maps already contain material colour.
	// A gentle tint preserves that range instead of multiplying it down twice.
	ALBEDO = colour.rgb * mix(vec3(1.0), tint.rgb, tint_strength) * brightness_value;
	if (edge_enabled) {
		vec2 p = surface_position.xz;
		vec4 distances = vec4(p.x - edge_rect.x, p.y - edge_rect.y, edge_rect.z - p.x, edge_rect.w - p.y);
		distances = mix(vec4(10000.0), distances, edge_sides);
		float boundary = min(min(distances.x, distances.z), min(distances.y, distances.w));
		vec3 native_edge = texture(edge_texture, p * edge_scale).rgb;
		float irregularity = dot(texture(edge_texture, p * edge_scale * 0.77 + vec2(0.21, 0.47)).rgb, vec3(0.299, 0.587, 0.114));
		float coverage = smoothstep(0.01, 0.17, boundary + (irregularity - 0.66) * edge_width * 1.7);
		ALBEDO = mix(native_edge * edge_multiplier, ALBEDO, coverage);
	}
	ROUGHNESS = clamp(roughness_value + (dot(base_colour.rgb, vec3(0.299, 0.587, 0.114)) - 0.5) * 0.12, 0.48, 1.0);
	// Horizontal surfaces get wet in rain (walls stay mostly dry).
	float wet = clamp(zh_wetness, 0.0, 1.0) * smoothstep(0.6, 0.9, abs(surface_normal.y));
	ALBEDO *= 1.0 - wet * 0.26;
	ROUGHNESS = mix(ROUGHNESS, 0.38, wet);
	ALBEDO *= scene_colour;
	METALLIC = metalness;
	vec2 texel = 1.0 / vec2(textureSize(surface_texture, 0));
	// Height differences must sample the same map on both sides. Mixing the
	// macro wear colour into h0 created false broad normals on flat asphalt.
	float h0 = dot(base_colour.rgb, vec3(0.299, 0.587, 0.114));
	float hx = dot(texture(surface_texture, uv + vec2(texel.x, 0.0)).rgb, vec3(0.299, 0.587, 0.114));
	float hy = dot(texture(surface_texture, uv + vec2(0.0, texel.y)).rgb, vec3(0.299, 0.587, 0.114));
	NORMAL_MAP = normalize(vec3((h0 - hx) * bump_strength * 12.0, (h0 - hy) * bump_strength * 12.0, 1.0)) * 0.5 + 0.5;
}
␀␀␀␀␀shader_type spatial;
render_mode cull_disabled;

// Terrain of a rebuilt world area (first: Safezone + surroundings). One plane,
// eight photographic materials blended by two splat maps (2 texels per metre,
// generated from the area layout by tools/goldstandard_safezone.gd):
//   splat_a: r grass, g dry grass / litter, b earth, a gravel
//   splat_b: r asphalt, g worn asphalt, b pavers, a concrete
// Transitions are broken up by the materials' own luminance so edges read as
// worn ground, not blurred stripes. World-mapped (no tiling seams).
uniform sampler2D splat_a : filter_linear, repeat_disable;
uniform sampler2D splat_b : filter_linear, repeat_disable;
// Aufgabe A (Block 33): the water-hole variant is the same shader â€“ tiles
// without water keep the default black mask and never discard (one GPU
// program less to compile in the browser).
uniform sampler2D hole_mask : hint_default_black, filter_linear, repeat_disable;
uniform vec4 area_rect; // world metres: x, z, width, depth
uniform vec2 stage_origin; // world metres of stage (0, 0)
uniform sampler2D grass_texture : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D litter_texture : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D earth_texture : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D gravel_texture : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D asphalt_texture : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D worn_texture : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D paver_texture : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D concrete_texture : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform vec4 scale_a = vec4(0.125, 0.16, 0.24, 0.52); // texture repeats per metre
uniform vec4 scale_b = vec4(0.22, 0.2, 0.3, 0.3);
uniform vec4 bright_a = vec4(1.0, 0.92, 0.82, 1.0);
uniform vec4 bright_b = vec4(0.7, 0.72, 0.88, 0.8);
uniform float breakup = 0.55;
// Landschaft (Sebastian 25.10.: Felder in der Spielansicht klarer): field map of
// a landscape tile, 2 texels per metre (tools: werkzeug_p2_landplan5) â€“
//   r field cover, g/b furrow direction per field (cos 2Î¸, sin 2Î¸),
//   a crop Ã— 50 + tone Ã— 40 (0 Getreide-Stoppel, 1 Raps, 2 Mais, 3 Acker, 4 Brache).
// Furrows and crop stand are drawn here, sharp at any zoom (the splat's
// baked 0.75-m rows on 0.5-m texels read as washed stripes). Other terrain
// keeps the black default and skips the branch.
uniform sampler2D field_map : hint_default_black, filter_linear, repeat_disable;
uniform sampler2D field_crop : hint_default_black, filter_nearest, repeat_disable;
uniform vec3 scene_colour = vec3(1.0);
// Rain wetness (main.gd weather): darker, glossier ground, puddle sheen on paving.
global uniform float zh_wetness;
varying vec3 world_position;

void vertex() {
	world_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

float luma(vec3 c) {
	return dot(c, vec3(0.299, 0.587, 0.114));
}

// Anti-aliased row profile: 1 on a band of relative width w around each row
// centre (period 1 in x), 0 between; fades to the mean where rows get finer
// than a pixel.
float rows(float x, float w) {
	float f = abs(fract(x) - 0.5) * 2.0; // 0 on the row centre â€¦ 1 between
	float aa = fwidth(x) * 2.0;
	float band = 1.0 - smoothstep(w - aa, w + aa, f);
	return mix(band, w, clamp(aa * 1.5 - 0.5, 0.0, 1.0));
}

// Cheap hash for stubble / stalk scatter.
float cell_hash(vec2 c) {
	return fract(sin(dot(c, vec2(127.1, 311.7))) * 43758.5453);
}

// Field surface for crop k at world point p (furrow frame along/across).
vec3 field_surface(int k, vec2 p, vec2 along, vec2 across, float tone, vec3 earth, vec3 litter, vec3 grass, vec3 base) {
	float a = dot(p, along);
	float s = dot(p, across);
	vec3 soil = earth * mix(0.82, 1.0, tone);
	if (k == 3) {
		// Acker (gepflÃ¼gt): 0.75-m furrows, lit ridge side and shadowed furrow.
		float x = s / 0.75;
		float ridge = rows(x, 0.42);
		float side = smoothstep(0.0, 1.0, fract(x)) - 0.5;
		return soil * (0.72 + 0.4 * ridge + 0.18 * side);
	}
	if (k == 0) {
		// Getreide-Stoppel: straw stubble in 0.17-m drill rows on dry soil.
		float x = s / 0.17;
		float stubble = rows(x, 0.38) * (0.65 + 0.35 * step(0.35, cell_hash(vec2(floor(x), floor(a / 0.09)))));
		vec3 straw = litter * vec3(1.18, 1.1, 0.86) * mix(0.9, 1.1, tone);
		return mix(soil * 0.78, straw, 0.35 + 0.55 * stubble);
	}
	if (k == 1) {
		// Raps (verwildert): green clumps in 0.45-m rows, a few small yellow
		// flowers (round, fading to their mean where smaller than a pixel).
		float x = s / 0.45;
		float clump = rows(x, 0.6) * mix(0.55, 1.0, cell_hash(vec2(floor(x), floor(a / 0.3))));
		vec3 green = grass * vec3(0.95, 1.12, 0.62) * mix(0.95, 1.12, tone);
		// flowers only in loose patches (late bloom of self-sown rape)
		vec2 fc = vec2(dot(p, vec2(0.83, 0.56)), dot(p, vec2(-0.56, 0.83))) / 0.37;
		vec2 jitter = vec2(cell_hash(floor(fc) + 7.3), cell_hash(floor(fc) + 3.1)) * 0.8 + 0.1;
		float r = length(fract(fc) - jitter) * 0.37;
		float px = fwidth(fc.x) * 0.37;
		float patch_ = smoothstep(0.55, 0.8, cell_hash(floor(p / 5.0)) * 0.6 + cell_hash(floor(p / 2.3) + 11.0) * 0.4);
		float dot_ = (1.0 - smoothstep(0.03 - px, 0.03 + px, r)) * step(0.88 - 0.25 * patch_, cell_hash(floor(fc)));
		dot_ = mix(dot_, 0.01 + 0.02 * patch_, clamp(px * 25.0 - 0.5, 0.0, 1.0));
		vec3 flower = vec3(0.78, 0.7, 0.32);
		return mix(mix(soil * 0.9, green, 0.45 + 0.5 * clump), flower, dot_ * 0.65);
	}
	if (k == 2) {
		// Mais-Stoppel: 0.75-m ridges with stalk stumps every 0.18 m and their shadow.
		float x = s / 0.75;
		float ridge = rows(x, 0.3);
		vec2 stalk_cell = vec2(floor(x), floor(a / 0.18));
		vec2 local = vec2(fract(x) - 0.5, fract(a / 0.18) - 0.5);
		float stump = (1.0 - smoothstep(0.05, 0.11, length(local * vec2(0.75 / 0.18, 1.0)))) * step(0.25, cell_hash(stalk_cell));
		float shade = (1.0 - smoothstep(0.05, 0.16, length((local - vec2(0.08, -0.12)) * vec2(0.75 / 0.18, 1.0)))) * step(0.25, cell_hash(stalk_cell));
		vec3 straw = litter * vec3(1.15, 1.05, 0.8);
		vec3 c = soil * (0.8 + 0.25 * ridge) * (1.0 - 0.3 * shade);
		return mix(c, straw, stump * 0.9);
	}
	// Brache: the splat's rough meadow, old rows barely visible.
	return base * (0.96 + 0.06 * rows(s / 0.75, 0.4));
}

void fragment() {
	vec2 p = world_position.xz + stage_origin;
	vec2 suv = (p - area_rect.xy) / area_rect.zw;
	if (texture(hole_mask, suv).r > 0.5) { discard; }
	vec4 wa = texture(splat_a, suv);
	vec4 wb = texture(splat_b, suv);
	// Two rotated samples per material hide the repeat of each photograph.
	vec2 q = vec2(p.x * 0.83 - p.y * 0.56, p.x * 0.56 + p.y * 0.83);
	vec3 grass = mix(texture(grass_texture, p * scale_a.x).rgb, texture(grass_texture, q * scale_a.x * 0.71 + 0.3).rgb, 0.45) * bright_a.x;
	vec3 litter = mix(texture(litter_texture, p * scale_a.y).rgb, texture(litter_texture, q * scale_a.y * 0.77 + 0.6).rgb, 0.4) * bright_a.y;
	vec3 earth = mix(texture(earth_texture, p * scale_a.z).rgb, texture(earth_texture, q * scale_a.z * 0.69 + 0.1).rgb, 0.4) * bright_a.z;
	vec3 gravel = texture(gravel_texture, p * scale_a.w).rgb * bright_a.w;
	vec3 asphalt = texture(asphalt_texture, p * scale_b.x).rgb * bright_b.x;
	vec3 worn = mix(texture(worn_texture, p * scale_b.y).rgb, texture(worn_texture, q * scale_b.y * 0.8 + 0.4).rgb, 0.35) * bright_b.y;
	vec3 pavers = texture(paver_texture, p * scale_b.z).rgb * bright_b.z;
	vec3 concrete = texture(concrete_texture, p * scale_b.w).rgb * bright_b.w;
	// Height-like breakup: darker (lower) texels give way first at a seam.
	vec4 ha = vec4(luma(grass), luma(litter), luma(earth), luma(gravel));
	vec4 hb = vec4(luma(asphalt), luma(worn), luma(pavers), luma(concrete));
	vec4 ka = max(wa + (ha - 0.45) * breakup * wa * (1.0 - wa) * 4.0, vec4(0.0));
	vec4 kb = max(wb + (hb - 0.45) * breakup * wb * (1.0 - wb) * 4.0, vec4(0.0));
	ka = pow(ka, vec4(2.0));
	kb = pow(kb, vec4(2.0));
	float total = dot(ka, vec4(1.0)) + dot(kb, vec4(1.0)) + 0.0001;
	vec3 colour = (grass * ka.r + litter * ka.g + earth * ka.b + gravel * ka.a + asphalt * kb.r + worn * kb.g + pavers * kb.b + concrete * kb.a) / total;
	vec4 field = texture(field_map, suv);
	if (field.r > 0.02) {
		// sharp field edge: the 0.5-m cover read at its half-way line
		float aa = fwidth(field.r) + 0.02;
		float inside = smoothstep(0.5 - aa, 0.5 + aa, field.r);
		float theta = atan(field.b * 2.0 - 1.0, field.g * 2.0 - 1.0) * 0.5;
		vec2 along = vec2(cos(theta), sin(theta));
		vec2 across = vec2(-along.y, along.x);
		float code = texture(field_crop, suv).a * 255.0 + 0.5;
		int crop = int(code / 50.0);
		float tone = mod(code, 50.0) / 40.0;
		vec3 surface = field_surface(crop, p, along, across, tone, earth, litter, grass, colour);
		// a darker headland line 0.25 m inside the edge
		float rim = smoothstep(0.5 - aa, 0.5 + aa, field.r) * (1.0 - smoothstep(0.62, 0.8, field.r));
		colour = mix(colour, surface * (1.0 - 0.16 * rim), inside);
	}
	// Broad tonal variation (no visible tiling over hundreds of metres).
	float broad = luma(texture(earth_texture, p * 0.013).rgb) - luma(texture(grass_texture, q * 0.009).rgb);
	colour *= 1.0 + broad * 0.22;
	float paved = (kb.r + kb.g + kb.b + kb.a) / total;
	float wet = clamp(zh_wetness, 0.0, 1.0);
	// Block 34 (Sebastian's v123 night screenshot in rain): the gloss of wet
	// paving ended hard at the gravel seam and caught the lamp as one bright
	// sheet. The gloss now follows the paving averaged over ~2 m (soft seam),
	// stays a little rougher, and low spots in broad patches mirror most
	// (single reflections), on gravel too.
	vec2 reach = vec2(0.9) / area_rect.zw;
	float gloss = (paved + dot(texture(splat_b, suv + vec2(reach.x, 0.0)), vec4(1.0)) + dot(texture(splat_b, suv - vec2(reach.x, 0.0)), vec4(1.0))
		+ dot(texture(splat_b, suv + vec2(0.0, reach.y)), vec4(1.0)) + dot(texture(splat_b, suv - vec2(0.0, reach.y)), vec4(1.0))) / 5.0;
	gloss = clamp(gloss, 0.0, 1.0);
	float patch = mix(0.4, 1.0, smoothstep(-0.12, 0.22, broad));
	float puddle = wet * mix(0.4, 1.0, gloss) * patch * smoothstep(0.42, 0.18, luma(colour));
	colour *= 1.0 - wet * mix(0.22, 0.32, paved);
	ALBEDO = colour * scene_colour;
	ROUGHNESS = mix(mix(0.95, 0.8, paved), mix(0.74, 0.44, gloss), wet) - puddle * 0.24;
	SPECULAR = 0.25 + wet * 0.12 * gloss + puddle * 0.3;
}
